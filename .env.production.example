# Copy to .env on the server and fill in. Never commit the real .env.
# Generate each secret with: openssl rand -hex 24 (hex only; special characters break DATABASE_URL)

APP_DOMAIN=streambox.duckdns.org
S3_DOMAIN=streambox-files.duckdns.org

JWT_ACCESS_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ROOT_USER=streambox_admin
MINIO_ROOT_PASSWORD=

# Optional Google sign-in. Redirect URI: https://<APP_DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
