NODE_ENV=development
PORT=3000

# Host port 3307 maps to MySQL in docker-compose (avoids clashing with a local MySQL on 3306).
# Inside Docker, the api service overrides this to use the "mysql" hostname.
DATABASE_URL=mysql://root:root@localhost:3307/streambox

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Google OAuth (leave blank to disable the Google routes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
